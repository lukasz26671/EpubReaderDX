@inject IReaderStateService State
@inject IAppLocalizer L
@implements IDisposable

@if (State.IsBookmarksOpen)
{
    <div class="reader-drawer absolute top-2 right-2 sm:right-6 w-80 border rounded-2xl shadow-2xl p-5 z-50 flex flex-col">
        <div class="flex justify-between items-center mb-3 pb-2 reader-border border-b">
            <h3 class="font-bold text-sm flex items-center gap-2">
                <i data-lucide="bookmark" class="w-4 h-4 text-amber-500"></i>
                @L.T("bookmarks.title")
            </h3>
            <button type="button" class="p-1 reader-muted reader-hover rounded" @onclick="() => State.ToggleBookmarks()">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto space-y-2 text-xs pr-1">
            @if (State.Bookmarks.Count == 0)
            {
                <div class="text-center py-6 reader-muted">@L.T("bookmarks.empty")</div>
            }
            else
            {
                @foreach (var bm in State.Bookmarks)
                {
                    var bookmark = bm;
                    <div class="p-2.5 rounded-xl reader-surface-2 flex items-center justify-between reader-hover transition">
                        <button type="button" class="truncate pr-2 text-left flex-1" @onclick="() => Jump(bookmark.ChapterIndex)">
                            <p class="font-medium truncate">@bookmark.Title</p>
                            <span class="text-[10px] reader-muted">@L.T("bookmarks.chapter", bookmark.ChapterIndex + 1)</span>
                        </button>
                        <button type="button" class="reader-muted hover:text-red-500 p-1" @onclick="() => Remove(bookmark.Id)">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += HandleChange;
        L.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.OnChange -= HandleChange;
        L.OnChange -= HandleChange;
    }

    private void Jump(int chapterIndex)
    {
        State.GoToChapter(chapterIndex);
        State.ToggleBookmarks();
    }

    private Task Remove(Guid id) => State.RemoveBookmarkAsync(id);
}
