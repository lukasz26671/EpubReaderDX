@inject IReaderStateService State
@inject IAppLocalizer L
@implements IDisposable

@if (State.IsMetadataOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background:rgba(15,23,42,0.6); backdrop-filter:blur(4px)" @onclick="() => State.ToggleMetadata()">
        <div class="reader-modal-card border rounded-2xl max-w-md w-full p-6 shadow-2xl relative" @onclick:stopPropagation="true">
            <button type="button" class="absolute top-4 right-4 reader-muted reader-hover" @onclick="() => State.ToggleMetadata()">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                <i data-lucide="book-marked" class="w-5 h-5" style="color:var(--rs-accent)"></i>
                @L.T("meta.infoTitle")
            </h3>

            @if (!string.IsNullOrWhiteSpace(State.Book?.CoverDataUri))
            {
                <img src="@State.Book!.CoverDataUri" alt="@L.T("meta.cover")" class="w-28 h-auto rounded-lg shadow mb-4 mx-auto object-cover" />
            }

            <div class="space-y-3 text-xs">
                <div>
                    <span class="reader-muted block">@L.T("meta.title")</span>
                    <p class="font-semibold text-sm">@(State.Book?.Metadata.Title ?? "-")</p>
                </div>
                <div>
                    <span class="reader-muted block">@L.T("meta.author")</span>
                    <p class="font-medium">@(State.Book is null || State.Book.Metadata.Authors.Count == 0 ? "-" : string.Join(", ", State.Book.Metadata.Authors))</p>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <span class="reader-muted block">@L.T("meta.language")</span>
                        <p>@(State.Book?.Metadata.Language ?? "-")</p>
                    </div>
                    <div>
                        <span class="reader-muted block">@L.T("meta.publisher")</span>
                        <p>@(string.IsNullOrWhiteSpace(State.Book?.Metadata.Publisher) ? L.T("meta.publisherNone") : State.Book!.Metadata.Publisher)</p>
                    </div>
                </div>
                <div>
                    <span class="reader-muted block">@L.T("meta.chapters")</span>
                    <p>@(State.Book?.Chapters.Count ?? 0)</p>
                </div>
                <div>
                    <span class="reader-muted block">@L.T("meta.description")</span>
                    <p class="reader-muted italic max-h-32 overflow-y-auto mt-1 p-2 reader-surface-2 rounded-lg">
                        @(string.IsNullOrWhiteSpace(State.Book?.Metadata.Description) ? L.T("meta.descriptionNone") : State.Book!.Metadata.Description)
                    </p>
                </div>
                <div class="pt-2 reader-border border-t text-[10px] reader-muted leading-relaxed">
                    @L.T("meta.shortcuts")
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += HandleChange;
        L.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.OnChange -= HandleChange;
        L.OnChange -= HandleChange;
    }
}
