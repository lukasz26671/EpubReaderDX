@inject IReaderStateService State
@inject ITtsController Tts
@inject ILanguageDetector LangDetect
@inject IAppLocalizer L
@inject IEnumerable<ITtsEngine> TtsEngines
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@using EpubReader.Domain.Enums
@using EpubReader.Domain.Entities
@using EpubReader.Application.Interfaces
@implements IDisposable

@if (State.IsSettingsOpen)
{
    <div class="reader-drawer absolute top-2 bottom-2 right-2 sm:right-6 w-[22rem] sm:w-96 border rounded-2xl shadow-2xl p-5 z-50 transition-all flex flex-col min-h-0 overflow-hidden">
        <div class="flex justify-between items-center mb-3 pb-2 reader-border border-b shrink-0">
            <h3 class="font-bold text-sm flex items-center gap-2">
                <i data-lucide="palette" class="w-4 h-4" style="color:var(--rs-accent)"></i>
                @L.T("settings.title")
            </h3>
            <button type="button" class="p-1 reader-muted reader-hover rounded" @onclick="() => State.ToggleSettings()">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="settings-scroll space-y-5 text-xs min-h-0">
            <div>
                <label class="block font-medium reader-muted mb-2">@L.T("settings.uiLanguage")</label>
                <div class="grid grid-cols-3 gap-1.5">
                    <button type="button" class="@UiLangClass(UiLanguageKind.Auto)" style="@UiLangStyle(UiLanguageKind.Auto)" @onclick="() => SetUiLanguage(UiLanguageKind.Auto)">@L.T("settings.uiLangAuto")</button>
                    <button type="button" class="@UiLangClass(UiLanguageKind.English)" style="@UiLangStyle(UiLanguageKind.English)" @onclick="() => SetUiLanguage(UiLanguageKind.English)">@L.T("settings.uiLangEn")</button>
                    <button type="button" class="@UiLangClass(UiLanguageKind.Polish)" style="@UiLangStyle(UiLanguageKind.Polish)" @onclick="() => SetUiLanguage(UiLanguageKind.Polish)">@L.T("settings.uiLangPl")</button>
                </div>
            </div>

            <div>
                <label class="block font-medium reader-muted mb-2">@L.T("settings.theme")</label>
                <div class="grid grid-cols-5 gap-1.5">
                    @foreach (ReaderTheme theme in Enum.GetValues<ReaderTheme>())
                    {
                        var meta = ReaderThemeCss.ThemeMeta(theme);
                        var active = State.Settings.Theme == theme;
                        <button type="button" class="theme-swatch-btn @(active ? "is-active" : null)" title="@ThemeLabel(theme)" @onclick="() => SetTheme(theme)">
                            <span class="theme-swatch-dot" style="@($"background:{meta.Swatch}; box-shadow: inset 0 0 0 2px {meta.Accent}")"></span>
                            <span>@ThemeLabel(theme)</span>
                        </button>
                    }
                </div>
            </div>

            <div>
                <label class="block font-medium reader-muted mb-2">@L.T("settings.font")</label>
                <div class="grid grid-cols-2 gap-2">
                    @foreach (FontFamilyOption font in Enum.GetValues<FontFamilyOption>())
                    {
                        var meta = ReaderThemeCss.FontMeta(font);
                        <button type="button"
                                class="@FontButtonClass(font)"
                                style="@($"{FontButtonClassStyle(font)}; font-family:{ReaderThemeCss.FontStack(font)}")"
                                @onclick="() => SetFont(font)">
                            <span class="text-base leading-none">@meta.Sample</span>
                            <span>@meta.Label</span>
                        </button>
                    }
                </div>
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.fontSize")</label>
                    <span class="reader-muted">@State.Settings.FontSize px</span>
                </div>
                <input type="range" min="12" max="40" value="@State.Settings.FontSize" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnFontSizeInput" />
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.lineHeight")</label>
                    <span class="reader-muted">@State.Settings.LineHeight.ToString("0.0")</span>
                </div>
                <input type="range" min="1.1" max="2.8" step="0.1" value="@State.Settings.LineHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnLineHeightInput" />
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.letterSpacing")</label>
                    <span class="reader-muted">@State.Settings.LetterSpacing.ToString("0.00") em</span>
                </div>
                <input type="range" min="-0.05" max="0.2" step="0.01" value="@State.Settings.LetterSpacing.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnLetterSpacingInput" />
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.paragraphSpacing")</label>
                    <span class="reader-muted">@State.Settings.ParagraphSpacing.ToString("0.0")</span>
                </div>
                <input type="range" min="0.4" max="2.5" step="0.1" value="@State.Settings.ParagraphSpacing.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnParagraphSpacingInput" />
            </div>

            <div>
                <label class="block font-medium reader-muted mb-2">@L.T("settings.align")</label>
                <div class="grid grid-cols-3 gap-2">
                    <button type="button" class="@AlignClass(TextAlignOption.Left)" style="@AlignStyle(TextAlignOption.Left)" @onclick="() => SetAlign(TextAlignOption.Left)">@L.T("settings.alignLeft")</button>
                    <button type="button" class="@AlignClass(TextAlignOption.Justify)" style="@AlignStyle(TextAlignOption.Justify)" @onclick="() => SetAlign(TextAlignOption.Justify)">@L.T("settings.alignJustify")</button>
                    <button type="button" class="@AlignClass(TextAlignOption.Center)" style="@AlignStyle(TextAlignOption.Center)" @onclick="() => SetAlign(TextAlignOption.Center)">@L.T("settings.alignCenter")</button>
                </div>
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.width")</label>
                    <span class="reader-muted">@State.Settings.ContentWidth rem</span>
                </div>
                <input type="range" min="28" max="60" value="@State.Settings.ContentWidth" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnWidthInput" />
            </div>

            <div>
                <div class="flex justify-between mb-1">
                    <label class="font-medium reader-muted">@L.T("settings.margin")</label>
                    <span class="reader-muted">@State.Settings.PageMargin px</span>
                </div>
                <input type="range" min="8" max="48" value="@State.Settings.PageMargin" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnMarginInput" />
            </div>

            <label class="flex items-start gap-2.5 cursor-pointer select-none">
                <input type="checkbox" class="mt-0.5" style="accent-color:var(--rs-accent)"
                       checked="@State.Settings.InfiniteScroll"
                       @onchange="OnInfiniteScrollChange" />
                <span>
                    <span class="font-medium block">@L.T("settings.infiniteScroll")</span>
                    <span class="reader-muted text-[11px] leading-snug block mt-0.5">@L.T("settings.infiniteScrollHint")</span>
                </span>
            </label>

            <div class="pt-2 reader-border border-t space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <label class="font-medium reader-muted flex items-center gap-1.5">
                        <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
                        @L.T("settings.tts")
                    </label>
                    <span class="reader-muted">@DetectedLangLabel</span>
                </div>

                <div>
                    <label class="block font-medium reader-muted mb-2">@L.T("settings.ttsEngine")</label>
                    <div class="grid @(HasPiperEngine ? "grid-cols-2" : (HasEdgeEngine ? "grid-cols-3" : "grid-cols-2")) gap-1.5">
                        <button type="button" class="@TtsEngineClass(TtsEngineKind.Auto)" style="@TtsEngineStyle(TtsEngineKind.Auto)" @onclick="() => SetTtsEngine(TtsEngineKind.Auto)">Auto</button>
                        <button type="button" class="@TtsEngineClass(TtsEngineKind.System)" style="@TtsEngineStyle(TtsEngineKind.System)" @onclick="() => SetTtsEngine(TtsEngineKind.System)">System</button>
                        @if (HasEdgeEngine)
                        {
                            <button type="button" class="@TtsEngineClass(TtsEngineKind.EdgeNeural)" style="@TtsEngineStyle(TtsEngineKind.EdgeNeural)" title="Online / best effort" @onclick="() => SetTtsEngine(TtsEngineKind.EdgeNeural)">Edge</button>
                        }
                        @if (HasPiperEngine)
                        {
                            <button type="button" class="@TtsEngineClass(TtsEngineKind.Piper)" style="@TtsEngineStyle(TtsEngineKind.Piper)" title="Offline English neural (Windows/Android app)" @onclick="() => SetTtsEngine(TtsEngineKind.Piper)">Piper EN</button>
                        }
                    </div>
                    <p class="mt-1.5 reader-muted opacity-80 leading-snug">@TtsEngineHint</p>
                </div>

                @if (HasPiperEngine && State.Settings.TtsEngine == TtsEngineKind.Piper && Piper is not null)
                {
                    <div class="rounded-xl border overflow-hidden" style="border-color:var(--rs-border)">
                        <button type="button"
                                class="w-full flex items-center justify-between gap-2 px-3 py-2 reader-surface-2 reader-hover text-left"
                                @onclick="TogglePiperPanel">
                            <span class="font-medium flex items-center gap-1.5">
                                <i data-lucide="audio-lines" class="w-3.5 h-3.5"></i>
                                @L.T("settings.piperOptions")
                            </span>
                            <span class="reader-muted">@(_piperExpanded ? "▾" : "▸")</span>
                        </button>
                        @if (_piperExpanded)
                        {
                            <div class="px-3 py-3 space-y-3 border-t" style="border-color:var(--rs-border)">
                                <div>
                                    <label class="block font-medium reader-muted mb-1.5">@L.T("settings.piperVoice")</label>
                                    <select class="w-full rounded-lg border px-2 py-1.5 reader-surface-2"
                                            style="border-color:var(--rs-border); background:var(--rs-surface); color:inherit"
                                            value="@Piper.SelectedVoiceId"
                                            @onchange="OnPiperVoiceChange">
                                        @foreach (var voice in Piper.GetVoices())
                                        {
                                            <option value="@voice.Id">@voice.DisplayName — @voice.Detail@(voice.IsReady ? $" · {L.T("settings.piperReady")}" : "")</option>
                                        }
                                    </select>
                                </div>
                                <div class="rounded-lg px-2.5 py-2 text-[11px] leading-snug space-y-1.5"
                                     style="background:var(--rs-surface-2); border:1px solid var(--rs-border)">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="reader-muted">@L.T("settings.piperStatus")</span>
                                        <span class="text-right" style="@PiperStatusStyle">@PiperStatusText</span>
                                    </div>
                                    @if (Piper.Progress is double p && Piper.Phase is PiperPrepPhase.DownloadingRuntime or PiperPrepPhase.DownloadingVoice)
                                    {
                                        <div class="h-1.5 rounded-full overflow-hidden" style="background:var(--rs-border)">
                                            <div class="h-full rounded-full transition-all" style="@($"width:{(int)(p * 100)}%; background:var(--rs-accent)")"></div>
                                        </div>
                                    }
                                    else if (Piper.Phase is PiperPrepPhase.DownloadingRuntime or PiperPrepPhase.DownloadingVoice or PiperPrepPhase.Extracting)
                                    {
                                        <div class="h-1.5 rounded-full overflow-hidden relative" style="background:var(--rs-border)">
                                            <div class="absolute inset-y-0 w-1/3 rounded-full animate-pulse" style="background:var(--rs-accent); left:20%"></div>
                                        </div>
                                    }
                                    <p class="reader-muted opacity-80">@L.T("settings.piperHint")</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div>
                    <div class="flex justify-between mb-1">
                        <label class="font-medium reader-muted">@L.T("settings.ttsRate")</label>
                        <span class="reader-muted">@State.Settings.TtsRate.ToString("0.0")×</span>
                    </div>
                    <input type="range" min="0.5" max="2.0" step="0.1" value="@State.Settings.TtsRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="w-full" style="accent-color:var(--rs-accent)" @oninput="OnTtsRateInput" />
                </div>

                <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" class="mt-0.5" style="accent-color:var(--rs-accent)"
                           checked="@State.Settings.RestoreScrollPosition"
                           @onchange="OnRestoreScrollChange" />
                    <span>
                        <span class="font-medium block">@L.T("settings.restoreScroll")</span>
                        <span class="reader-muted text-[11px] leading-snug block mt-0.5">@L.T("settings.restoreScrollHint")</span>
                    </span>
                </label>

                <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" class="mt-0.5" style="accent-color:var(--rs-accent)"
                           checked="@State.Settings.RestoreTtsPosition"
                           @onchange="OnRestoreTtsChange" />
                    <span>
                        <span class="font-medium block">@L.T("settings.restoreTts")</span>
                        <span class="reader-muted text-[11px] leading-snug block mt-0.5">@L.T("settings.restoreTtsHint")</span>
                    </span>
                </label>

                <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" class="mt-0.5" style="accent-color:var(--rs-accent)"
                           checked="@State.Settings.TtsAutoNextChapter"
                           @onchange="OnTtsAutoNextChange" />
                    <span>
                        <span class="font-medium block">@L.T("settings.ttsAutoNext")</span>
                        <span class="reader-muted text-[11px] leading-snug block mt-0.5">@L.T("settings.ttsAutoNextHint")</span>
                    </span>
                </label>

                <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" class="mt-0.5" style="accent-color:var(--rs-accent)"
                           checked="@State.Settings.TtsAutoPlay"
                           @onchange="OnTtsAutoPlayChange" />
                    <span>
                        <span class="font-medium block">@L.T("settings.ttsAutoPlay")</span>
                        <span class="reader-muted text-[11px] leading-snug block mt-0.5">@L.T("settings.ttsAutoPlayHint")</span>
                    </span>
                </label>

                <div>
                    <label class="block font-medium reader-muted mb-1.5">@L.T("settings.ttsVoiceLang")</label>
                    @if (IsPiperLanguageLocked)
                    {
                        <select class="w-full rounded-lg border px-2 py-1.5 reader-surface-2 opacity-70 cursor-not-allowed"
                                style="border-color:var(--rs-border); background:var(--rs-surface); color:inherit"
                                disabled
                                value="en">
                            <option value="en">English (en)</option>
                        </select>
                        <p class="mt-1.5 reader-muted opacity-80 leading-snug">@L.T("settings.ttsLangPiperLocked")</p>
                    }
                    else
                    {
                        <select class="w-full rounded-lg border px-2 py-1.5 reader-surface-2" style="border-color:var(--rs-border); background:var(--rs-surface); color:inherit"
                                value="@(State.Settings.TtsLanguageOverride ?? "")"
                                @onchange="OnTtsLanguageChange">
                            <option value="">@L.T("settings.ttsLangAuto")</option>
                            <option value="pl">Polski (pl)</option>
                            <option value="en">English (en)</option>
                            <option value="zh-CN">中文简体 (zh-CN)</option>
                            <option value="zh-TW">中文繁體 (zh-TW)</option>
                            <option value="ja">日本語 (ja)</option>
                            <option value="ko">한국어 (ko)</option>
                            <option value="de">Deutsch (de)</option>
                            <option value="fr">Français (fr)</option>
                            <option value="es">Español (es)</option>
                            <option value="ru">Русский (ru)</option>
                        </select>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool HasPiperEngine => TtsEngines.Any(e => e.Kind == TtsEngineKind.Piper);
    private bool HasEdgeEngine => TtsEngines.Any(e => e.Kind == TtsEngineKind.EdgeNeural);
    private bool IsPiperLanguageLocked => HasPiperEngine && State.Settings.TtsEngine == TtsEngineKind.Piper;
    private IPiperVoiceService? Piper => Services.GetService<IPiperVoiceService>();
    private bool _piperExpanded = true;

    protected override void OnInitialized()
    {
        State.OnChange += HandleChange;
        Tts.OnChange += HandleChange;
        L.OnChange += HandleChange;
        if (Piper is not null) Piper.OnChange += HandleChange;

        // Web has no Piper — don't keep a stale preference selected.
        if (!HasPiperEngine && State.Settings.TtsEngine == TtsEngineKind.Piper)
            _ = SetTtsEngine(TtsEngineKind.Auto);
        if (!HasEdgeEngine && State.Settings.TtsEngine == TtsEngineKind.EdgeNeural)
            _ = SetTtsEngine(TtsEngineKind.Auto);

        if (State.Settings.TtsEngine == TtsEngineKind.Piper)
            _ = PreparePiperAsync();
    }

    private string TtsEngineHint =>
        HasPiperEngine
            ? L.T("settings.ttsEngineHint")
            : HasEdgeEngine
                ? L.T("settings.ttsEngineHintWeb")
                : L.T("settings.ttsEngineHintWebNoEdge");

    private void HandleChange() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.OnChange -= HandleChange;
        Tts.OnChange -= HandleChange;
        L.OnChange -= HandleChange;
        if (Piper is not null) Piper.OnChange -= HandleChange;
    }

    private string PiperStatusText
    {
        get
        {
            if (Piper is null) return "—";
            return Piper.Phase switch
            {
                PiperPrepPhase.Ready => L.T("settings.piperReady"),
                PiperPrepPhase.DownloadingRuntime => Piper.StatusMessage ?? L.T("settings.piperDownloadingRuntime"),
                PiperPrepPhase.DownloadingVoice => Piper.StatusMessage ?? L.T("settings.piperDownloadingVoice"),
                PiperPrepPhase.Extracting => Piper.StatusMessage ?? L.T("settings.piperExtracting"),
                PiperPrepPhase.Error => Piper.StatusMessage ?? L.T("settings.piperError"),
                _ => Piper.IsVoiceReady(Piper.SelectedVoiceId)
                    ? L.T("settings.piperReady")
                    : L.T("settings.piperNotDownloaded")
            };
        }
    }

    private string PiperStatusStyle => Piper?.Phase switch
    {
        PiperPrepPhase.Error => "color:#dc2626",
        PiperPrepPhase.Ready => "color:var(--rs-accent)",
        PiperPrepPhase.DownloadingRuntime or PiperPrepPhase.DownloadingVoice or PiperPrepPhase.Extracting
            => "color:var(--rs-accent)",
        _ => ""
    };

    private void TogglePiperPanel() => _piperExpanded = !_piperExpanded;

    private async Task PreparePiperAsync()
    {
        if (Piper is null) return;
        _piperExpanded = true;
        try { await Piper.EnsureReadyAsync(); }
        catch { /* status shown via Phase.Error */ }
    }

    private string DetectedLangLabel
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Tts.DetectedLanguage))
                return Tts.DetectedLanguage;
            if (State.CurrentChapter is null) return "—";
            return LangDetect.Detect(State.Book?.Metadata.Language, State.CurrentChapter.PlainText);
        }
    }

    private string ThemeLabel(ReaderTheme theme) => theme switch
    {
        ReaderTheme.Sepia => L.T("theme.sepia"),
        ReaderTheme.Paper => L.T("theme.paper"),
        ReaderTheme.Dark => L.T("theme.dark"),
        ReaderTheme.Nord => L.T("theme.nord"),
        ReaderTheme.Forest => L.T("theme.forest"),
        ReaderTheme.Rose => L.T("theme.rose"),
        ReaderTheme.Midnight => L.T("theme.midnight"),
        ReaderTheme.Solarized => L.T("theme.solarized"),
        ReaderTheme.Oled => L.T("theme.oled"),
        _ => L.T("theme.light")
    };

    private Task SetTheme(ReaderTheme theme)
    {
        var s = CloneSettings();
        s.Theme = theme;
        return State.UpdateSettingsAsync(s);
    }

    private Task SetFont(FontFamilyOption font)
    {
        var s = CloneSettings();
        s.FontFamily = font;
        return State.UpdateSettingsAsync(s);
    }

    private Task SetAlign(TextAlignOption align)
    {
        var s = CloneSettings();
        s.TextAlign = align;
        return State.UpdateSettingsAsync(s);
    }

    private async Task SetTtsEngine(TtsEngineKind engine)
    {
        var s = CloneSettings();
        s.TtsEngine = engine;
        await State.UpdateSettingsAsync(s);
        if (engine == TtsEngineKind.Piper)
            await PreparePiperAsync();
    }

    private async Task OnPiperVoiceChange(ChangeEventArgs e)
    {
        if (Piper is null) return;
        var id = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(id)) return;
        _piperExpanded = true;
        try { await Piper.SelectVoiceAsync(id); }
        catch { /* status via Phase.Error */ }
    }

    private Task SetUiLanguage(UiLanguageKind lang)
    {
        var s = CloneSettings();
        s.UiLanguage = lang;
        return State.UpdateSettingsAsync(s);
    }

    private string FontButtonClass(FontFamilyOption font) =>
        State.Settings.FontFamily == font
            ? "p-2 border-2 rounded-xl text-xs font-medium transition flex flex-col items-center gap-1"
            : "p-2 border rounded-xl text-xs font-medium reader-surface-2 reader-hover transition flex flex-col items-center gap-1";

    private string AlignClass(TextAlignOption align) =>
        State.Settings.TextAlign == align
            ? "p-2 rounded-xl border-2 font-medium"
            : "p-2 rounded-xl border reader-surface-2 reader-hover";

    private string AlignStyle(TextAlignOption align) =>
        State.Settings.TextAlign == align
            ? "border-color:var(--rs-accent); background:var(--rs-active); color:var(--rs-active-text)"
            : "border-color:var(--rs-border)";

    private string FontButtonClassStyle(FontFamilyOption font) =>
        State.Settings.FontFamily == font
            ? "border-color:var(--rs-accent); background:var(--rs-active); color:var(--rs-active-text)"
            : "border-color:var(--rs-border)";

    private string TtsEngineClass(TtsEngineKind engine) =>
        State.Settings.TtsEngine == engine
            ? "p-2 rounded-xl border-2 font-medium"
            : "p-2 rounded-xl border reader-surface-2 reader-hover";

    private string TtsEngineStyle(TtsEngineKind engine) =>
        State.Settings.TtsEngine == engine
            ? "border-color:var(--rs-accent); background:var(--rs-active); color:var(--rs-active-text)"
            : "border-color:var(--rs-border)";

    private string UiLangClass(UiLanguageKind lang) =>
        State.Settings.UiLanguage == lang
            ? "p-2 rounded-xl border-2 font-medium"
            : "p-2 rounded-xl border reader-surface-2 reader-hover";

    private string UiLangStyle(UiLanguageKind lang) =>
        State.Settings.UiLanguage == lang
            ? "border-color:var(--rs-accent); background:var(--rs-active); color:var(--rs-active-text)"
            : "border-color:var(--rs-border)";

    private Task OnFontSizeInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.FontSize = (int)v);
    private Task OnLineHeightInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.LineHeight = v);
    private Task OnLetterSpacingInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.LetterSpacing = v);
    private Task OnParagraphSpacingInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.ParagraphSpacing = v);
    private Task OnWidthInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.ContentWidth = (int)v);
    private Task OnMarginInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.PageMargin = (int)v);
    private Task OnTtsRateInput(ChangeEventArgs e) => UpdateNumber(e, (s, v) => s.TtsRate = v);

    private Task OnRestoreScrollChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        s.RestoreScrollPosition = IsChecked(e);
        return State.UpdateSettingsAsync(s);
    }

    private Task OnRestoreTtsChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        s.RestoreTtsPosition = IsChecked(e);
        return State.UpdateSettingsAsync(s);
    }

    private Task OnTtsAutoNextChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        s.TtsAutoNextChapter = IsChecked(e);
        return State.UpdateSettingsAsync(s);
    }

    private Task OnTtsAutoPlayChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        s.TtsAutoPlay = IsChecked(e);
        return State.UpdateSettingsAsync(s);
    }

    private Task OnInfiniteScrollChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        s.InfiniteScroll = IsChecked(e);
        return State.UpdateSettingsAsync(s);
    }

    private static bool IsChecked(ChangeEventArgs e) => e.Value switch
    {
        bool b => b,
        string s => s is "true" or "on" or "True",
        _ => false
    };

    private Task OnTtsLanguageChange(ChangeEventArgs e)
    {
        var s = CloneSettings();
        var v = e.Value?.ToString();
        s.TtsLanguageOverride = string.IsNullOrWhiteSpace(v) ? null : v;
        return State.UpdateSettingsAsync(s);
    }

    private Task UpdateNumber(ChangeEventArgs e, Action<ReaderSettings, double> apply)
    {
        var s = CloneSettings();
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            apply(s, v);
        }
        return State.UpdateSettingsAsync(s);
    }

    private ReaderSettings CloneSettings() => new()
    {
        Theme = State.Settings.Theme,
        FontFamily = State.Settings.FontFamily,
        FontSize = State.Settings.FontSize,
        LineHeight = State.Settings.LineHeight,
        LetterSpacing = State.Settings.LetterSpacing,
        ParagraphSpacing = State.Settings.ParagraphSpacing,
        TextAlign = State.Settings.TextAlign,
        ContentWidth = State.Settings.ContentWidth,
        PageMargin = State.Settings.PageMargin,
        TtsEngine = State.Settings.TtsEngine,
        TtsRate = State.Settings.TtsRate,
        TtsLanguageOverride = State.Settings.TtsLanguageOverride,
        PiperVoiceId = State.Settings.PiperVoiceId,
        RestoreScrollPosition = State.Settings.RestoreScrollPosition,
        RestoreTtsPosition = State.Settings.RestoreTtsPosition,
        TtsAutoNextChapter = State.Settings.TtsAutoNextChapter,
        TtsAutoPlay = State.Settings.TtsAutoPlay,
        InfiniteScroll = State.Settings.InfiniteScroll,
        UiLanguage = State.Settings.UiLanguage
    };
}
